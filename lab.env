# Single source of truth for every lab setting.
# Read by scripts/*.sh (bash `source`). scripts/generate-kind-config.sh fills
# ckad-cluster.template.yaml with these values to produce ckad-cluster.yaml.
# After editing: scripts/generate-kind-config.sh, then scripts/down.sh and scripts/up.sh
# (every value below only takes effect when the network or cluster is created).

# kind cluster name; the kubectl context becomes kind-<CLUSTER_NAME>.
CLUSTER_NAME=ckad

# Subnet of the Docker network "kind", which holds the node IPs. Matches the subnet of the
# training environment's VPC. Must not overlap other Docker networks, POD_SUBNET or SERVICE_SUBNET.
KIND_NETWORK_SUBNET=10.2.0.0/24

# Node image, i.e. the Kubernetes version: the minor version the CKAD exam runs, with the @sha256
# digest from the kind release notes (a bare tag is not guaranteed to match the release).
NODE_IMAGE=kindest/node:v1.35.8@sha256:07b2536e30b803ed61d1677a79df6115f798ce64c80f9e22f6ed45afd09323c0

# Pod and Service IP ranges (kind's defaults).
POD_SUBNET=10.244.0.0/16
SERVICE_SUBNET=10.96.0.0/16

# Host ports mapped to the control-plane node's ports 80 and 443, where the Ingress controller
# listens: http://localhost:<INGRESS_HTTP_HOST_PORT>, https://localhost:<INGRESS_HTTPS_HOST_PORT>.
# High ports avoid clashing with local web servers. 11080 and 11443 are unassigned in the IANA port
# registry (checked 2026-09-14) and outside the Kubernetes NodePort range (30000-32767) and the
# macOS ephemeral port range (49152-65535).
INGRESS_HTTP_HOST_PORT=11080
INGRESS_HTTPS_HOST_PORT=11443

# Not a setting: derived so it can never disagree with kind. kind probes for docker first and falls
# back to podman, and KIND_EXPERIMENTAL_PROVIDER overrides that choice; this mirrors the same rule,
# so the scripts always talk to the engine holding the node containers.
CONTAINER_ENGINE=${KIND_EXPERIMENTAL_PROVIDER:-$(command -v docker >/dev/null && echo docker || echo podman)}
